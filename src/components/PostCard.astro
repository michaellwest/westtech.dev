---
import TagPill from "./TagPill.astro";

interface Props {
  title: string;
  date: Date;
  description: string;
  tags: string[];
  slug: string;
  heroImage?: string | boolean;
  eager?: boolean;
}

const { title, date, description, tags, slug, heroImage, eager = false } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const thumbnailSrc =
  heroImage === false
    ? null
    : typeof heroImage === "string"
      ? heroImage
      : `/og/${slug}.png`;
---

<article class="group relative bg-white dark:bg-zinc-900 ring-1 ring-zinc-200 dark:ring-zinc-800 rounded-xl p-5 hover:ring-zinc-300 dark:hover:ring-zinc-700 transition-shadow">
  <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
    {thumbnailSrc && (
      <div class="block w-full sm:w-[200px] sm:h-[105px] sm:shrink-0 rounded-md overflow-hidden ring-1 ring-zinc-200 dark:ring-zinc-800">
        <img
          src={thumbnailSrc}
          alt=""
          width="1200"
          height="630"
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager ? "high" : "auto"}
          decoding="async"
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <div class="flex-1 min-w-0">
      <div class="relative z-10 flex flex-wrap gap-1.5 mb-2">
        {tags.map((tag) => <TagPill tag={tag} />)}
      </div>

      <h2 class="text-lg font-semibold mb-1">
        <a
          href={`/${slug}`}
          class="text-zinc-900 dark:text-zinc-50 hover:text-blue-600 dark:hover:text-blue-400 transition-colors after:content-[''] after:absolute after:inset-0"
        >
          {title}
        </a>
      </h2>

      <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-2">
        {description}
      </p>

      <time
        datetime={date.toISOString()}
        class="text-xs text-zinc-400 dark:text-zinc-500"
      >
        {formattedDate}
      </time>
    </div>
  </div>
</article>
