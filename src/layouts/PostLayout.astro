---
import SiteLayout from "./SiteLayout.astro";
import Card from "../components/Card.astro";
import TagPill from "../components/TagPill.astro";

interface Props {
  title: string;
  created: Date;
  updated?: Date;
  description: string;
  tags: string[];
  source?: string;
  migrated?: boolean;
  heroImage?: boolean | string;
  slug?: string;
  ogImage?: string;
}

const { title, created, updated, description, tags, source, migrated, heroImage, slug, ogImage } = Astro.props;

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<SiteLayout title={title} description={description} ogImage={ogImage}>
  <Card as="article" padding="p-6 sm:p-8">
    {typeof heroImage === "string" && (
      <img
        src={heroImage}
        alt=""
        class="w-full rounded-lg mb-8"
        loading="eager"
      />
    )}
    {heroImage === true && slug && (
      <img
        src={`/og/${slug}.png`}
        alt=""
        class="w-full rounded-lg mb-8"
        loading="eager"
      />
    )}
    <header class="mb-8">
      <div class="flex flex-wrap gap-2 mb-3">
        {tags.map((tag) => <TagPill tag={tag} />)}
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-2">
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <time
          datetime={created.toISOString()}
          class="text-sm text-zinc-500 dark:text-zinc-400"
        >
          {formatDate(created)}
        </time>
        {
          updated && (
            <time
              datetime={updated.toISOString()}
              class="text-sm text-zinc-500 dark:text-zinc-400 italic"
            >
              Updated {formatDate(updated)}
            </time>
          )
        }
      </div>
    </header>

    {
      migrated && source && (
        <p class="migrated-notice">
          Originally published on{' '}
          <a href={source} rel="noopener noreferrer">
            michaellwest.blogspot.com
          </a>
        </p>
      )
    }

    <!-- Prose styles for rendered Markdown -->
    <div class="prose-styles">
      <slot />
    </div>
  </Card>
</SiteLayout>

<style>
  /* Tailwind v4 requires @reference in scoped style blocks that use @apply */
  @reference "../styles/global.css";

  /* Scoped prose styles — avoids needing @tailwindcss/typography plugin */
  .prose-styles :global(h2) {
    @apply text-xl font-semibold mt-8 mb-3 text-zinc-900 dark:text-zinc-100;
  }
  .prose-styles :global(h3) {
    @apply text-lg font-semibold mt-6 mb-2 text-zinc-900 dark:text-zinc-100;
  }
  .prose-styles :global(p) {
    @apply mb-4 leading-7 text-zinc-700 dark:text-zinc-300;
  }
  .prose-styles :global(a) {
    @apply text-blue-600 dark:text-blue-400 underline underline-offset-2 hover:text-blue-800 dark:hover:text-blue-300 break-words;
  }
  .prose-styles :global(ul) {
    @apply list-disc pl-5 mb-4 space-y-1 text-zinc-700 dark:text-zinc-300;
  }
  .prose-styles :global(ol) {
    @apply list-decimal pl-5 mb-4 space-y-1 text-zinc-700 dark:text-zinc-300;
  }
  .prose-styles :global(li) {
    @apply leading-7;
  }
  .prose-styles :global(strong) {
    @apply font-semibold text-zinc-900 dark:text-zinc-100;
  }
  .prose-styles :global(code:not(pre code)) {
    @apply bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 rounded px-1.5 py-0.5 font-mono;
    font-size: 0.9em;
  }
  .prose-styles :global(pre) {
    @apply relative rounded-lg my-5 overflow-x-auto text-sm;
  }
  .prose-styles :global(pre code) {
    @apply block px-4 pb-4 pt-6;
  }
  /* Language tag in the top-right corner of each code block. */
  .prose-styles :global(pre[data-language])::before {
    content: attr(data-language);
    @apply absolute top-2 right-3 font-mono text-zinc-400/80 select-none pointer-events-none;
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
  }
  /* Map the `ps` Shiki alias to "powershell" for display. */
  .prose-styles :global(pre[data-language="ps"])::before {
    content: "powershell";
  }
  /* Hide tag for plain-text fences. */
  .prose-styles :global(pre[data-language="text"])::before,
  .prose-styles :global(pre[data-language="plaintext"])::before {
    content: none;
  }
  .prose-styles :global(blockquote) {
    @apply border-l-4 border-blue-500 pl-4 italic text-zinc-600 dark:text-zinc-400 my-4;
  }
  .prose-styles :global(hr) {
    @apply border-zinc-200 dark:border-zinc-800 my-8;
  }
  .prose-styles :global(img) {
    @apply rounded-lg my-6 max-w-full;
  }
  .migrated-notice {
    @apply text-xs text-zinc-500 dark:text-zinc-400 mb-6;
  }
  .migrated-notice :global(a) {
    @apply text-zinc-500 dark:text-zinc-400 underline hover:text-zinc-700 dark:hover:text-zinc-300;
  }
  .prose-styles :global(table) {
    @apply w-full text-sm border-collapse my-4;
  }
  .prose-styles :global(th) {
    @apply border border-zinc-200 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-800 px-3 py-2 text-left font-semibold;
  }
  .prose-styles :global(td) {
    @apply border border-zinc-200 dark:border-zinc-700 px-3 py-2;
  }
  .prose-styles :global(.mermaid-block),
  .prose-styles :global(pre.mermaid) {
    @apply flex justify-center my-6;
    background: transparent;
  }
  .prose-styles :global(.mermaid-block img),
  .prose-styles :global(.mermaid-block svg) {
    @apply max-w-full;
    max-width: 720px;
  }
</style>
