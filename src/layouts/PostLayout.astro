---
import SiteLayout from "./SiteLayout.astro";
import Card from "../components/Card.astro";
import TagPill from "../components/TagPill.astro";

interface Props {
  title: string;
  created: Date;
  updated?: Date;
  description: string;
  tags: string[];
  source?: string;
  migrated?: boolean;
  heroImage?: boolean | string;
  slug?: string;
  ogImage?: string;
}

const { title, created, updated, description, tags, source, migrated, heroImage, slug, ogImage } = Astro.props;

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<SiteLayout title={title} description={description} ogImage={ogImage}>
  <Card as="article" padding="p-6 sm:p-8">
    {typeof heroImage === "string" && (
      <img
        src={heroImage}
        alt=""
        class="w-full rounded-lg mb-8"
        loading="eager"
      />
    )}
    {heroImage === true && slug && (
      <img
        src={`/og/${slug}.png`}
        alt=""
        class="w-full rounded-lg mb-8"
        loading="eager"
      />
    )}
    <header class="mb-8">
      <div class="flex flex-wrap gap-2 mb-3">
        {tags.map((tag) => <TagPill tag={tag} />)}
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-2">
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <time
          datetime={created.toISOString()}
          class="text-sm text-zinc-500 dark:text-zinc-400"
        >
          {formatDate(created)}
        </time>
        {
          updated && (
            <time
              datetime={updated.toISOString()}
              class="text-sm text-zinc-500 dark:text-zinc-400 italic"
            >
              Updated {formatDate(updated)}
            </time>
          )
        }
      </div>
    </header>

    {
      migrated && source && (
        <p class="migrated-notice">
          Originally published on{' '}
          <a href={source} rel="noopener noreferrer">
            michaellwest.blogspot.com
          </a>
        </p>
      )
    }

    <!-- Prose styles for rendered Markdown -->
    <div class="prose-styles">
      <slot />
    </div>
  </Card>
</SiteLayout>

<style>
  /* Tailwind v4 requires @reference in scoped style blocks that use @apply */
  @reference "../styles/global.css";

  /* Scoped prose styles — avoids needing @tailwindcss/typography plugin */
  .prose-styles :global(h2) {
    @apply text-xl font-semibold mt-8 mb-3 text-zinc-900 dark:text-zinc-100;
  }
  .prose-styles :global(h3) {
    @apply text-lg font-semibold mt-6 mb-2 text-zinc-900 dark:text-zinc-100;
  }
  .prose-styles :global(p) {
    @apply mb-4 leading-7 text-zinc-700 dark:text-zinc-300;
  }
  .prose-styles :global(a) {
    @apply text-blue-600 dark:text-blue-400 underline underline-offset-2 hover:text-blue-800 dark:hover:text-blue-300 break-words;
  }
  .prose-styles :global(ul) {
    @apply list-disc pl-5 mb-4 space-y-1 text-zinc-700 dark:text-zinc-300;
  }
  .prose-styles :global(ol) {
    @apply list-decimal pl-5 mb-4 space-y-1 text-zinc-700 dark:text-zinc-300;
  }
  .prose-styles :global(li) {
    @apply leading-7;
  }
  .prose-styles :global(strong) {
    @apply font-semibold text-zinc-900 dark:text-zinc-100;
  }
  .prose-styles :global(code:not(pre code)) {
    @apply bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 rounded px-1.5 py-0.5 font-mono;
    font-size: 0.9em;
  }
  .prose-styles :global(pre) {
    @apply relative rounded-lg my-5 overflow-x-auto text-sm;
  }
  .prose-styles :global(pre code) {
    @apply block px-4 pb-4 pt-10;
  }
  /* Language tag in the top-left corner of each code block.
     Top-right is reserved for the copy button (injected by the script below). */
  .prose-styles :global(pre[data-language])::before {
    content: attr(data-language);
    @apply absolute top-2 left-3 font-mono text-zinc-400/80 select-none pointer-events-none;
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
  }
  /* Map the `ps` Shiki alias to "powershell" for display. */
  .prose-styles :global(pre[data-language="ps"])::before {
    content: "powershell";
  }
  /* Hide tag for plain-text fences. */
  .prose-styles :global(pre[data-language="text"])::before,
  .prose-styles :global(pre[data-language="plaintext"])::before {
    content: none;
  }
  /* Copy-code button. Injected at runtime by the script below; styled here
     so resting/hover/success/error states ship in the CSS bundle. */
  .prose-styles :global(.copy-btn) {
    @apply absolute top-1.5 right-1.5 inline-flex items-center gap-1 px-1.5 py-1 rounded-md font-mono text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 hover:bg-zinc-200/60 dark:hover:bg-zinc-700/60 transition-colors cursor-pointer;
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
  }
  .prose-styles :global(.copy-btn-label) {
    @apply hidden;
  }
  .prose-styles :global(.copy-btn.is-success),
  .prose-styles :global(.copy-btn.is-error) {
    @apply text-zinc-900 dark:text-zinc-100;
  }
  .prose-styles :global(.copy-btn.is-success .copy-btn-label),
  .prose-styles :global(.copy-btn.is-error .copy-btn-label) {
    @apply inline;
  }
  .prose-styles :global(.copy-btn svg) {
    @apply w-3.5 h-3.5;
  }
  .prose-styles :global(blockquote) {
    @apply border-l-4 border-blue-500 pl-4 italic text-zinc-600 dark:text-zinc-400 my-4;
  }
  .prose-styles :global(hr) {
    @apply border-zinc-200 dark:border-zinc-800 my-8;
  }
  .prose-styles :global(img) {
    @apply rounded-lg my-6 max-w-full;
  }
  .migrated-notice {
    @apply text-xs text-zinc-500 dark:text-zinc-400 mb-6;
  }
  .migrated-notice :global(a) {
    @apply text-zinc-500 dark:text-zinc-400 underline hover:text-zinc-700 dark:hover:text-zinc-300;
  }
  .prose-styles :global(table) {
    @apply w-full text-sm border-collapse my-4;
  }
  .prose-styles :global(th) {
    @apply border border-zinc-200 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-800 px-3 py-2 text-left font-semibold;
  }
  .prose-styles :global(td) {
    @apply border border-zinc-200 dark:border-zinc-700 px-3 py-2;
  }
  .prose-styles :global(.mermaid-block),
  .prose-styles :global(pre.mermaid) {
    @apply flex justify-center my-6;
    background: transparent;
  }
  .prose-styles :global(.mermaid-block img),
  .prose-styles :global(.mermaid-block svg) {
    @apply max-w-full;
    max-width: 720px;
  }
</style>

<script>
  // Copy-code button. Walks every Shiki <pre> in the post body, injects a small
  // top-right button, copies the inner <code> textContent on click. Mermaid
  // blocks are skipped automatically — rehype-mermaid emits .mermaid-block, not
  // pre.astro-code. Selector also excludes any other non-Shiki <pre>.
  const COPY_RESET_MS = 1500;
  const ICON_CLIPBOARD =
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
  const ICON_CHECK =
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
  // Per-button reset timer. Stored externally so rapid clicks clear the
  // stale timer before scheduling a fresh one — otherwise the previous
  // click's timeout would prematurely revert the new state.
  const resetTimers = new WeakMap<HTMLButtonElement, number>();

  function setState(btn: HTMLButtonElement, state: "" | "success" | "error", label: string, icon: string) {
    btn.classList.toggle("is-success", state === "success");
    btn.classList.toggle("is-error", state === "error");
    const iconEl = btn.querySelector(".copy-btn-icon");
    const labelEl = btn.querySelector(".copy-btn-label");
    const statusEl = btn.querySelector(".copy-btn-status");
    if (iconEl) iconEl.innerHTML = icon;
    if (labelEl) labelEl.textContent = label;
    const aria = state === "success" ? "Code copied" : state === "error" ? "Copy failed" : "Copy code";
    btn.setAttribute("aria-label", aria);
    btn.title = aria;
    // Drive the aria-live region only on the active states so the polite
    // announcer doesn't re-fire when the button resets back to "Copy code".
    if (statusEl) {
      statusEl.textContent =
        state === "success" ? "Code copied to clipboard" : state === "error" ? "Copy failed" : "";
    }
  }

  // Legacy fallback for insecure contexts (LAN/Tailscale dev over plain HTTP,
  // file://, etc.) where navigator.clipboard is unavailable. The hidden
  // textarea + execCommand("copy") path doesn't require a secure origin —
  // only a user-activation event, which the click handler is.
  function legacyCopy(text: string): boolean {
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.setAttribute("readonly", "");
    ta.style.position = "fixed";
    ta.style.top = "0";
    ta.style.left = "0";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    try {
      return document.execCommand("copy");
    } catch {
      return false;
    } finally {
      document.body.removeChild(ta);
    }
  }

  async function copyPre(pre: HTMLPreElement, btn: HTMLButtonElement) {
    const code = pre.querySelector("code");
    if (!code) return;
    // Strip Shiki's trailing newline so pasting a single-line snippet into
    // a shell doesn't auto-execute on the closing fence's implicit \n.
    const text = (code.textContent ?? "").replace(/\n+$/, "");
    if (!text) return;
    let ok = false;
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        ok = true;
      } catch (err) {
        console.warn("[copy-btn] clipboard API failed, trying legacy", err);
      }
    }
    if (!ok) ok = legacyCopy(text);
    setState(btn, ok ? "success" : "error", ok ? "Copied" : "Failed", ok ? ICON_CHECK : ICON_CLIPBOARD);
    const prev = resetTimers.get(btn);
    if (prev !== undefined) clearTimeout(prev);
    resetTimers.set(
      btn,
      window.setTimeout(() => setState(btn, "", "Copy", ICON_CLIPBOARD), COPY_RESET_MS)
    );
  }

  document.querySelectorAll<HTMLPreElement>(".prose-styles pre.astro-code").forEach((pre) => {
    // Skip empty fenced blocks — no useful copy target, and the secure /
    // insecure paths report inconsistent feedback for an empty string.
    const code = pre.querySelector("code");
    if (!code || !(code.textContent ?? "").trim()) return;
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "copy-btn";
    btn.setAttribute("aria-label", "Copy code");
    btn.title = "Copy code";
    btn.innerHTML = `<span class="copy-btn-icon" aria-hidden="true">${ICON_CLIPBOARD}</span><span class="copy-btn-label" aria-hidden="true">Copy</span><span class="copy-btn-status sr-only" aria-live="polite"></span>`;
    btn.addEventListener("click", () => copyPre(pre, btn));
    pre.appendChild(btn);
  });
</script>
