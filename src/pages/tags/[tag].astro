---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Card from "../../components/Card.astro";
import PostCard from "../../components/PostCard.astro";

// Cloudflare adapter prerenders getStaticPaths in an isolated context that
// doesn't close over module-scope consts — keep the slugify body inlined
// inside getStaticPaths below, not a call to this helper.
const slugify = (tag: string) => tag.toLowerCase().replace(/\s+/g, "-");

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const tagToPosts = new Map<string, typeof posts>();
  const displayName = new Map<string, string>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = tag.toLowerCase().replace(/\s+/g, "-");
      if (!tagToPosts.has(slug)) {
        tagToPosts.set(slug, []);
        displayName.set(slug, tag);
      }
      tagToPosts.get(slug)!.push(post);
    }
  }

  return [...tagToPosts.entries()].map(([slug, tagged]) => ({
    params: { tag: slug },
    props: {
      tag: displayName.get(slug)!,
      posts: tagged.sort(
        (a, b) => b.data.created.getTime() - a.data.created.getTime()
      ),
    },
  }));
};

type PostEntry = Awaited<ReturnType<typeof getCollection<"posts">>>[number];

interface Props {
  tag: string;
  posts: PostEntry[];
}

const { tag, posts } = Astro.props;
const canonicalUrl = new URL(`/tags/${slugify(tag)}/`, Astro.site).toString();
---

<SiteLayout
  title={`Posts tagged "${tag}" — westtech.dev`}
  description={`Posts on westtech.dev tagged ${tag}.`}
  canonicalUrl={canonicalUrl}
>
  <Card as="section" class="mb-6">
    <p class="text-xs font-semibold uppercase tracking-widest text-zinc-500 dark:text-zinc-400 mb-1">Tag</p>
    <h1 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50">{tag}</h1>
    <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
      {posts.length} {posts.length === 1 ? "post" : "posts"}
      &middot; <a href="/" class="text-blue-600 dark:text-blue-400 hover:underline">All posts</a>
    </p>
  </Card>

  <section>
    <ul class="space-y-4">
      {posts.map((post, index) => (
        <li>
          <PostCard
            title={post.data.title}
            date={post.data.created}
            description={post.data.description}
            tags={post.data.tags}
            slug={post.id}
            heroImage={post.data.heroImage}
            eager={index === 0}
          />
        </li>
      ))}
    </ul>
  </section>
</SiteLayout>
